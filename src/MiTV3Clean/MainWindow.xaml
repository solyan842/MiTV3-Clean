<Window x:Class="MiTV3Clean.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MiTV3 Clean · SolYan" Height="790" Width="1260"
        MinHeight="680" MinWidth="1050"
        Background="#0E0E0E" Foreground="White">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="MiTV3 CLEAN" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="Audit · Debloat · Restore · Couchy Launcher" Foreground="#AAA" FontSize="14"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#1C1C1C" CornerRadius="10" Padding="12,8">
                <TextBlock Text="v0.1.2 · SolYan" Foreground="#FF9B42"/>
            </Border>
        </Grid>

        <Border Grid.Row="1" Margin="0,16,0,12" Background="#171717" CornerRadius="12" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="TV IP" VerticalAlignment="Center" Margin="4"/>
                <TextBox x:Name="IpBox" Grid.Column="1" Text="192.168.1.2" Margin="6" Padding="9"
                         Background="#242424" Foreground="White" BorderBrush="#444"/>
                <Button Grid.Column="2" Content="Kết nối ADB" Click="Connect_Click"/>
                <TextBlock x:Name="DeviceText" Grid.Column="3" Margin="12,0" VerticalAlignment="Center"
                           Foreground="#CFCFCF" Text="Chưa kết nối"/>
                <Button Grid.Column="4" Content="Quét package" Click="Scan_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="PackageGrid" ItemsSource="{Binding Packages}" AutoGenerateColumns="False"
                      CanUserAddRows="False" IsReadOnly="False" HeadersVisibility="Column"
                      Background="#111" Foreground="White" RowBackground="#151515"
                      AlternatingRowBackground="#1B1B1B" BorderBrush="#333"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#2A2A2A">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="✓" Binding="{Binding Selected}" Width="42"/>
                    <DataGridTextColumn Header="Nhóm" Binding="{Binding Group}" Width="155" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Package" Binding="{Binding Name}" Width="280" IsReadOnly="True"/>
                    <DataGridCheckBoxColumn Header="System" Binding="{Binding IsSystem}" Width="70" IsReadOnly="True"/>
                    <DataGridCheckBoxColumn Header="Disabled" Binding="{Binding IsDisabled}" Width="75" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Lý do" Binding="{Binding Reason}" Width="*" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                <Border Background="#171717" CornerRadius="12" Padding="12">
                    <StackPanel>
                        <TextBlock Text="DỌN AN TOÀN" FontWeight="SemiBold" Foreground="#FF9B42"/>
                        <Button Content="Chọn ứng viên dọn" Click="SelectCandidates_Click"/>
                        <Button Content="Disable đã chọn" Click="Disable_Click"/>
                        <Button Content="Khôi phục / Enable" Click="Restore_Click"/>
                        <Separator Margin="4,10"/>
                        <Button Content="Gỡ cho user 0" Click="Uninstall_Click"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#999" Margin="5"
                                   Text="Gỡ user 0 sâu hơn Disable nhưng không xóa APK khỏi /system. Luôn thử Disable + reboot trước."/>
                    </StackPanel>
                </Border>

                <Border Background="#171717" CornerRadius="12" Padding="12" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="COUCHY LAUNCHER" FontWeight="SemiBold" Foreground="#FF9B42"/>
                        <Button Content="Tải + cài Couchy" Click="InstallCouchy_Click"/>
                        <Button Content="Đặt Couchy làm HOME" Click="SetCouchyHome_Click"/>
                        <Button Content="Chẩn đoán HOME" Click="DiagnoseHome_Click"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#999" Margin="5"
                                   Text="v0.1.2 đọc HOME thật bằng KEYCODE_HOME + window/activity focus, phù hợp Android 5.1.1 của MiTV3."/>
                    </StackPanel>
                </Border>

                <Border Background="#171717" CornerRadius="12" Padding="12" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="NHẬT KÝ" FontWeight="SemiBold"/>
                        <TextBox x:Name="LogBox" Height="180" Margin="4,8,4,4" IsReadOnly="True"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 Background="#101010" Foreground="#BFBFBF" BorderBrush="#333"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="3" Margin="2,12,2,0" Foreground="#777"
                   Text="MiTV3 Clean · non-root · disable-first · snapshots stored locally · https://github.com/solyan842/MiTV3-Clean"/>
    </Grid>
</Window>
